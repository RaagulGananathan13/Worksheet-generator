# Docker Compose reads .env automatically. run.py uses actual environment variables.
# Set your real domain and a unique long secret before public deployment.
AG_DOMAIN=worksheets.example.com
AG_BOOTSTRAP_TOKEN=replace-with-a-random-secret-at-least-32-characters
AG_SECURE_COOKIES=1
AG_ALLOWED_ORIGINS=https://worksheets.example.com
OCR_MIN_CONFIDENCE=0.98
OCR_CPU_THREADS=2
