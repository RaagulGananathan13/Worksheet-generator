# Copy this file to .env and fill in your own values. Never commit .env.

# API server
PORT=3001
# Use a long random value (for example 64 random characters).
JWT_SECRET=your-jwt-secret-here

# MySQL: the database and tables are created automatically on first start.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=worksheet_generator

# AWS S3 cloud save/library (optional for local editing and PDF export).
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-worksheet-bucket
AWS_S3_KEY_PREFIX=worksheets
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key